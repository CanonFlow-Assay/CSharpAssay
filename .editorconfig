root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csproj,props,targets}]
indent_style = space
indent_size = 4

[*.{json,md,slnx,yml,yaml}]
indent_style = space
indent_size = 2

[*.cs]
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion
csharp_style_namespace_declarations = file_scoped:suggestion
csharp_style_prefer_primary_constructors = false:silent
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
dotnet_style_prefer_collection_expression = never:suggestion

# Keep style guidance advisory; correctness and Assay rules remain build gates.
dotnet_analyzer_diagnostic.category-Style.severity = suggestion
dotnet_diagnostic.IDE0005.severity = silent
dotnet_diagnostic.IDE0022.severity = suggestion
dotnet_diagnostic.IDE0046.severity = suggestion

# TypeGym harness deliberately shares the challenge namespace.
dotnet_diagnostic.IDE0130.severity = suggestion
