<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Description>Editor and build diagnostics for CSharpAssay.</Description>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>CsAssay.Analyzers</PackageId>
    <Version>0.1.1</Version>
    <Title>CSharpAssay analyzers</Title>
    <PackageTags>csharp;roslyn;analyzer;functional-programming;null-safety</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <DevelopmentDependency>true</DevelopmentDependency>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../CsAssay.Domain/CsAssay.Domain.csproj" />
    <ProjectReference Include="../CsAssay.Catalogue/CsAssay.Catalogue.csproj" />
    <ProjectReference Include="../CsAssay.SdkAdapter/CsAssay.SdkAdapter.csproj" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <None Include="$(TargetPath)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="$(TargetDir)CsAssay.Catalogue.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="$(TargetDir)CsAssay.Domain.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="$(TargetDir)CsAssay.SdkAdapter.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="buildTransitive/CsAssay.Analyzers.props" Pack="true" PackagePath="buildTransitive" Visible="false" />
    <None Include="buildTransitive/CsAssay.Analyzers.targets" Pack="true" PackagePath="buildTransitive" Visible="false" />
    <None Include="../../docs/packaging/analyzers/README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
