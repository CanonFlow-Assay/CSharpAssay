<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <!-- Prove the package gate independently of the repository target gate. -->
    <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <!-- Model an ordinary consumer, not this repository's global strict build. -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors></WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Good.cs" />
    <Compile Include="Violation.cs"
             Condition="'$(QualificationViolation)' == 'true'" />
    <Compile Include="UnrelatedWarning.cs"
             Condition="'$(QualificationUnrelatedWarning)' == 'true'" />
    <PackageReference Include="CsAssay.Analyzers"
                      Version="0.2.0-rc.1"
                      PrivateAssets="all" />
  </ItemGroup>
</Project>
